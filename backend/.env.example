# MongoDB Atlas connection string, including the database name.
MONGODB_URI=mongodb://127.0.0.1:27017/cozy-garden
# Long random secret used to sign authentication tokens.
JWT_SECRET=replace-with-a-long-random-secret
# Heroku supplies PORT; 5000 is the local development fallback.
PORT=5000
# Exact browser origin allowed to make credentialed requests.
CLIENT_ORIGIN=http://localhost:5173
# Set to production on Heroku to enable secure cross-site cookies.
NODE_ENV=development
